#include <bits/stdc++.h>
using namespace std;

class Node{
    public:
     int data;
     Node* next;
     
     //defining constructor
     Node(int data , Node* next){
        this->data = data;
        this->next = next;
     }
     
     //defining constructor for nullptr
     
     Node(int data){
         this->data = data;
         this->next = nullptr;
     }
    
    
};

Node* ConvertArrToLL(vector<int> &arr){
    
    int n = arr.size();
    
    //Creating head
    
    Node* head = new Node(arr[0]);
    Node* mover = head;
    
    for(int i = 1; i<n; i++){
        
        Node* temp = new Node(arr[i]);
        mover->next = temp; 
    }
    
    return head;
}
int main() {
	// your code goes here
	vector<int> arr = {1 , 2 , 3, 4};
	
	//Object calling
	Node* head = ConvertArrToLL(arr);
	cout<<head->data;
}
